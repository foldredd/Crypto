<Page
    x:Class="TestAssignment.Convert"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#0C1727" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="₿" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Crypto" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button Content="Обзор" Style="{StaticResource NavButtonStyle}" Click="GoHome" />
                    <Button Content="Поиск" Style="{StaticResource NavButtonStyle}" Click="GoSearch" />
                    <Button Content="Конвертер" Style="{StaticResource NavButtonStyle}" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
            <Grid Padding="28,34" MaxWidth="860" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Конвертер валют" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Актуальный курс криптовалют к мировым валютам" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="СУММА" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,0,0,8" />
                                <TextBox x:Name="AmountBox" Style="{StaticResource FieldStyle}" PlaceholderText="0,00" InputScope="Number" MaxLength="24" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="КРИПТОВАЛЮТА" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,0,0,8" />
                                <ComboBox x:Name="CoinBox" Style="{StaticResource ComboStyle}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="РЕЗУЛЬТАТ" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,0,0,8" />
                                <Border Background="#0B1728" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" MinHeight="44"><TextBlock x:Name="ResultText" Text="—" FontSize="18" FontWeight="SemiBold" /></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ВАЛЮТА" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,0,0,8" />
                                <ComboBox x:Name="FiatBox" Style="{StaticResource ComboStyle}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <Button x:Name="ConvertButton" Content="Рассчитать" Style="{StaticResource PrimaryButtonStyle}" Click="ConvertClick" />
                            <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24" Margin="14,0,0,0" />
                            <TextBlock x:Name="ErrorText" Foreground="#FF7A90" Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="LoadingPanel" Background="{StaticResource PanelBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Spacing="12">
                            <ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Загружаем валюты…" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
