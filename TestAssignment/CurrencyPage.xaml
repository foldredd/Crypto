<Page
    x:Class="TestAssignment.СurrencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:TestAssignment.Converter">
    <Page.Resources><converter:PriceChangePercentageColorConverter x:Key="ChangeColor" /></Page.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#0C1727" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="₿" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Crypto" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button Content="Обзор" Style="{StaticResource NavButtonStyle}" Click="GoHome" />
                    <Button Content="Поиск" Style="{StaticResource NavButtonStyle}" Click="GoSearch" />
                    <Button Content="Конвертер" Style="{StaticResource NavButtonStyle}" Click="GoConvert" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
            <Grid Padding="28,30" MaxWidth="1180" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="{Binding Image}" Width="64" Height="64" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SymbolDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PriceDisplay}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PriceChangeDisplay}" Foreground="{Binding price_change_percentage_24h, Converter={StaticResource ChangeColor}}" FontSize="15" HorizontalAlignment="Right" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="300" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><TextBlock Text="Цена за 24 часа" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="USD" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" /></Grid>
                            <Viewbox Grid.Row="2" Stretch="Fill">
                                <Canvas Width="680" Height="260">
                                    <Line X1="0" Y1="65" X2="680" Y2="65" Stroke="#203149" StrokeThickness="1" />
                                    <Line X1="0" Y1="130" X2="680" Y2="130" Stroke="#203149" StrokeThickness="1" />
                                    <Line X1="0" Y1="195" X2="680" Y2="195" Stroke="#203149" StrokeThickness="1" />
                                    <Polyline x:Name="PriceLine" Stroke="#6C8CFF" StrokeThickness="3" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Grid Grid.Row="3"><TextBlock x:Name="StartTimeText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBlock x:Name="EndTimeText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" /></Grid>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="14">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="20">
                            <StackPanel><TextBlock Text="Рыночная капитализация" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Market_cap_string}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="USD" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="20">
                            <StackPanel><TextBlock Text="Объём торгов за 24 часа" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Total_volume_string}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="USD" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="20">
                            <StackPanel><TextBlock Text="Место в рейтинге" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding RankDisplay}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
