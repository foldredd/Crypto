<Page
    x:Class="TestAssignment.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#0C1727" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="₿" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Crypto" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button Content="Обзор" Style="{StaticResource NavButtonStyle}" Click="GoHome" />
                    <Button Content="Поиск" Style="{StaticResource NavButtonStyle}" Foreground="White" />
                    <Button Content="Конвертер" Style="{StaticResource NavButtonStyle}" Click="GoConvert" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Padding="28,26,28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Поиск активов" FontSize="30" FontWeight="SemiBold" />
                <TextBox x:Name="SearchBox" Style="{StaticResource FieldStyle}" PlaceholderText="Название или тикер" Margin="0,18,0,0" MaxWidth="760" HorizontalAlignment="Stretch" TextChanged="SearchChanged" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <ListView x:Name="ResultsList" ItemsSource="{Binding Results}" SelectionChanged="CurrencySelected">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="68" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Image}" Width="38" Height="38" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding SymbolDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" VerticalAlignment="Center" Margin="20,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding MarketCapDisplay}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><ProgressRing IsActive="True" Width="36" Height="36" /><TextBlock Text="Загружаем каталог…" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Ничего не найдено" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Попробуйте другое название или тикер" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><TextBlock Text="Не удалось загрузить каталог" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ErrorText" Foreground="{StaticResource MutedTextBrush}" MaxWidth="420" TextAlignment="Center" /><Button Content="Повторить" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="RetryClick" /></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
