<Page
    x:Class="TestAssignment.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#0C1727" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="₿" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Crypto" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button Content="Обзор" Style="{StaticResource NavButtonStyle}" Foreground="White" />
                    <Button Content="Поиск" Style="{StaticResource NavButtonStyle}" Click="GoSearch" />
                    <Button Content="Конвертер" Style="{StaticResource NavButtonStyle}" Click="GoConvert" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="28,26,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Рынок криптовалют" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Крупнейшие активы по рыночной капитализации" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Обновить" Style="{StaticResource NavButtonStyle}" VerticalAlignment="Center" Click="RefreshClick" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="18,0" Background="#0D192A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="АКТИВ" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="ЦЕНА" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="24 ЧАСА" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="ОБЪЁМ" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="КАПИТАЛИЗАЦИЯ" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="CurrencyList" Grid.Row="1" ItemsSource="{Binding CryptodataListProperty}" SelectionChanged="CurrencySelected" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="64" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Market_cap_rank}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding Image}" Width="34" Height="34" Stretch="Uniform" />
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SymbolDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ChangeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding VolumeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding MarketCapDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="36" Height="36" />
                        <TextBlock Text="Получаем данные рынка…" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <TextBlock Text="Не удалось загрузить рынок" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" MaxWidth="420" />
                        <Button Content="Повторить" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="RefreshClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
